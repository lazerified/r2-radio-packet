#!/usr/bin/env bash
set -e

echo "[pre-commit] 1/3: running `cargo fmt`"
cargo fmt --all --check

MODIFIED_FILES=$(git diff --name-only)
if [ -n "$MODIFIED_FILES" ]; then
    echo "[pre-commit] found misformatted code - corrected and added to "
    git add -u
fi

echo "[pre-commit] 2/3: linting with `cargo clippy`"
cargo clippy --all-targets --all-features -- -D warnings

echo "[pre-commit] 3/3: running tests with `cargo test`"
cargo test --quiet

echo "[pre-commit] SUCCESS: formatting, linting and testing passed correctly."
